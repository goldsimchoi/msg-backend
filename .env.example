# 필수. python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_DB=msg_backend
POSTGRES_USER=postgres
POSTGRES_PASSWORD=1234
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# WSGI DB connection reuse in seconds; set 0 to close after each request.
POSTGRES_CONN_MAX_AGE=60

# Gunicorn request slots. Start with 2 workers × 4 threads, then size for the
# actual CPU and database connection limits.
WEB_CONCURRENCY=2
GUNICORN_WORKER_CLASS=gthread
GUNICORN_THREADS=4
GUNICORN_KEEPALIVE=10
GUNICORN_TIMEOUT=30

REDIS_URL=redis://127.0.0.1:6379/1
# Positive finite seconds per connection / socket operation, not a whole-request deadline.
REDIS_CONNECT_TIMEOUT_SECONDS=1
REDIS_SOCKET_TIMEOUT_SECONDS=1
# Do not add socket timeout or retry overrides to REDIS_URL query parameters.

# Internal production APP: require TLS for both datastores.
# Set True, supply both CA paths below, and use:
# REDIS_URL=rediss://ctf_cache:<URL-encoded-password>@10.90.10.30:6379/1
DATASTORE_TLS_REQUIRED=False
# POSTGRES_SSLMODE=verify-full
# POSTGRES_SSLROOTCERT=/run/ctf-ca/ca.crt
# REDIS_SSL_CA_CERTS=/run/ctf-ca/ca.crt
# Mount the CA read-only. Certificate IP SANs must match the connection hosts.
# Migration-only jobs: omit DATASTORE_TLS_REQUIRED and Redis variables;
# keep POSTGRES_SSLMODE, POSTGRES_SSLROOTCERT and the migrator DB credentials.

# 필수. python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# KOTH 팀 토큰용 별도 비밀값. 운영에서는 JWT_SECRET과 다른 값을 사용하세요.
KOTH_TEAM_TOKEN_SECRET=
# Ranking response freshness in seconds. Set 0 to disable the shared read cache.
KOTH_LEADERBOARD_CACHE_SECONDS=1


SCHEDULER_API_TOKEN=

# Runtime #70 proposal: keep disabled until the provider API and permissions are verified.
IMAGE_PREPARATION_ENABLED=False
IMAGE_PREPARATION_RUNTIME_URL=
IMAGE_PREPARATION_API_TOKEN=
# Trusted operator-owned target IDs, not user input or node names.
IMAGE_PREPARATION_TARGET_IDS=
IMAGE_PREPARATION_TIMEOUT_SECONDS=5
IMAGE_PREPARATION_POLL_SECONDS=15
IMAGE_PREPARATION_MAX_ATTEMPTS=3
# Explicit opt-in: retain current release until fresh all-target/all-node readiness
IMAGE_PREPARATION_ACTIVATE_WHEN_READY=False
IMAGE_PREPARATION_READINESS_MAX_AGE_SECONDS=60
SCHEDULER_BASE_URL=http://127.0.0.1:8001
SCHEDULER_TIMEOUT_SECONDS=5
# Keep both disabled until Azure assignment and the real checker are verified.
EXE_SUBMISSIONS_ENABLED=False
EXE_DISPATCH_ENABLED=False
# Windows EXE only: use a logical Runtime checker pool ID from EXE_CHECKERS_JSON.
EXE_WINDOWS_DIRECT_RUNTIME_ENABLED=False
EXE_WINDOWS_RUNTIME_POOL_ID=
# Absolute private directory, outside MEDIA_ROOT and any web server document root.
EXE_SUBMISSION_STORAGE_ROOT=
# Backend-only signing key, at least 32 characters. Never copy it into the Windows guest.
EXE_CHECKER_SIGNING_KEY=
# Worker UUID -> HTTPS origin, service_token_env and approved execution hashes (see docs/windows-remote-run.md).
EXE_CHECKERS_JSON={}
RESOURCE_BROKER_BASE_URL=http://127.0.0.1:8002
RESOURCE_BROKER_TIMEOUT_SECONDS=5
INVENTORY_API_TOKEN=
INSTANCE_EXTEND_MINUTES=30

RELEASE_POLL_API_BASE=https://api.github.com
RELEASE_POLL_REPO=MSG-CTF/2026_MSG_CTF
RELEASE_POLL_GITHUB_TOKEN=
RELEASE_POLL_LIMIT=100
RELEASE_POLL_SOURCE_REF=refs/heads/main
# Recording alone never starts a workflow; dispatch uses the separate opt-in below.
PUBLICATION_REQUESTS_ENABLED=False
# Enable only after caller #99 is deployed and Backend integration is verified.
# Repository-scoped Actions: Write and Contents: Read. Keep the Poller token read-only.
PUBLICATION_DISPATCH_ENABLED=False
PUBLICATION_DISPATCH_GITHUB_TOKEN=

# 관리자 환경변수 가져오기: 기본은 위 GitHub 저장소의 main
# 로컬 검증에서만 읽기 전용 Git 체크아웃 경로 지정, 비워두면 GitHub API 사용
REPOSITORY_ENV_GIT_DIR=
REPOSITORY_ENV_REF=main

# Runtime worker의 비밀값 조회 전용 토큰, 다른 서비스 토큰과 별도로 발급
RUNTIME_SECRET_API_TOKEN=
# 쉼표로 구분한 Fernet 키 목록, 첫 키로 암호화하고 이전 키로도 복호화
# 생성: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RUNTIME_SECRET_ENCRYPTION_KEYS=
GCS_ENABLED=False
GCS_PROJECT_ID=msg-broker
GCS_BUCKET_NAME=2026msg_gcs
GCS_OBJECT_PREFIX=dev
# Empty disables administrator access to scheduled games; configure gateways first
KOTH_ADMIN_PREVIEW_ORIGINS=
